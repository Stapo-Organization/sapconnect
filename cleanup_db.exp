#!/usr/bin/expect -f
match_max 100000
set password "h23N1KXMIL#\$94"
spawn ssh -o StrictHostKeyChecking=no sapapimuntajat@62.138.14.178
expect "password:"
send "$password\r"
expect "$ "
send "cat << 'PHP_SCRIPT' > sapconnect_app/cleanup_transfers.php\n"
send "<?php\n"
send "require __DIR__.'/vendor/autoload.php';\n"
send "\$app = require_once __DIR__.'/bootstrap/app.php';\n"
send "\$kernel = \$app->make(Illuminate\\\\Contracts\\\\Console\\\\Kernel::class);\n"
send "\$kernel->bootstrap();\n"
send "\$sap = app()->make(App\\\\Services\\\\SAP\\\\SapClient::class);\n"
send "\$sap->setCompanyDb('PPTC_V5_PROD');\n"
send "\$validEntries = [];\n"
send "\$skip = 0; \$top = 1000;\n"
send "do {\n"
send "    \$res = \$sap->get('InventoryTransferRequests', ['\\\$select' => 'DocEntry', '\\\$top' => \$top, '\\\$skip' => \$skip]);\n"
send "    \$data = \$res['value'] ?? [];\n"
send "    foreach(\$data as \$d) { \$validEntries[] = \$d['DocEntry']; }\n"
send "    \$skip += count(\$data);\n"
send "    echo \\\"Fetched \\\" . count(\$validEntries) . \\\"\\\\n\\\";\n"
send "} while(count(\$data) == \$top);\n"
send "echo \\\"Total Valid Requests: \\\" . count(\$validEntries) . \\\"\\\\n\\\";\n"
send "if (count(\$validEntries) > 0) {\n"
send "    \$deleted = App\\\\Models\\\\StockTransfer::whereNotIn('doc_entry', \$validEntries)->delete();\n"
send "    echo \\\"Deleted non-request records: \\\" . \$deleted . \\\"\\\\n\\\";\n"
send "}\n"
send "PHP_SCRIPT\n"
expect "$ "
send "cd sapconnect_app && php cleanup_transfers.php\n"
expect "$ "
send "rm cleanup_transfers.php\n"
send "exit\n"
expect eof
