#!/usr/bin/expect -f

set timeout 30
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"

# 1. Check Permissions
expect "$*"
send "ls -ld storage/framework/sessions\r"
send "ls -la storage/framework/sessions | head -n 5\r"

# 2. Check .env Session config (grep to retrieve only relevant lines)
expect "$*"
send "grep '^SESSION_' .env\r"
send "grep '^APP_URL' .env\r"

# 3. Check Logs for any specific errors
expect "$*"
send "tail -n 20 storage/logs/laravel.log\r"

expect "$*"
send "exit\r"
expect eof
