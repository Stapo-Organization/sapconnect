#!/usr/bin/expect -f

set timeout 30
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
# Check if ListProducts.php has 'ApiLog' string
send "grep 'ApiLog' app/Filament/Resources/ProductResource/Pages/ListProducts.php\r"
# Try creating a log manually via tinker - simplified quoting
send "php artisan tinker --execute=\"\\App\\Models\\ApiLog::create(\['method' => 'TEST_LOG', 'endpoint' => 'DEBUG', 'status_code' => 200, 'response_body' => 'Test log from tinker'\]);\"\r"
send "exit\r"
expect eof
