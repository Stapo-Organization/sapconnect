#!/usr/bin/expect -f

set timeout 60
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
send "tail -n 50 storage/logs/laravel.log\r"
send "php -r \"echo 'Config Bearer: ' . (config('services.taqnyat.bearer_token') ? 'SET' : 'MISSING') . PHP_EOL;\"\r"
send "php -r \"echo 'Config Sender: ' . config('services.taqnyat.sender') . PHP_EOL;\"\r"
send "exit\r"
expect eof
