#!/usr/bin/expect -f

set timeout 30
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
# Fetch latest log for ItemGroups and show the response_body (which contains the artisan output)
send "php artisan tinker --execute=\"\$log = \\App\\Models\\ApiLog::where('endpoint', 'ItemGroups')->latest()->first(); if(\$log) { echo 'LOG_FOUND: ' . \$log->response_body; } else { echo 'NO_LOG_FOUND'; }\"\r"
send "exit\r"
expect eof
