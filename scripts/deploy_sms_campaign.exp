#!/usr/bin/expect -f

set timeout 300
set user "sapapimuntajat"
set host "62.138.14.178"
set user_pass $env(DEPLOY_PASSWORD)

# 1. SCP
spawn scp sms_campaign.tar.gz $user@$host:.
expect {
    "assword:" { send "$user_pass\r"; exp_continue }
    "yes/no" { send "yes\r"; exp_continue }
    eof
}
wait

# 2. SSH
spawn ssh $user@$host
expect {
    "assword:" { send "$user_pass\r" }
    "yes/no" { send "yes\r" }
}

expect -re {[\$#]}

# 3. Navigate and Deploy
send "pwd\r"
expect -re {[\$#]}

send "cd sapconnect_app\r"
expect -re {[\$#]}

send "pwd\r"
expect -re {[\$#]}

send "mv ../sms_campaign.tar.gz .\r"
expect -re {[\$#]}

send "tar -xzf sms_campaign.tar.gz\r"
expect -re {[\$#]}

send "cat database/migrations/2026_01_15_000000_create_sms_campaigns_tables.php | head -n 5\r"
expect -re {[\$#]}

send "php artisan migrate --force\r"
expect -re {[\$#]}

send "rm sms_campaign.tar.gz\r"
expect -re {[\$#]}

send "exit\r"
expect eof
