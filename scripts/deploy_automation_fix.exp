#!/usr/bin/expect -f

set timeout 300
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn scp -o StrictHostKeyChecking=no scripts/run_automation_fix.php $user@$ip:/home/sapapimuntajat/sapconnect_app/run_automation_fix.php
expect "*assword:*"
send "$password\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
send "php run_automation_fix.php\r"
expect "$*"
send "rm run_automation_fix.php\r"
send "exit\r"
expect eof
