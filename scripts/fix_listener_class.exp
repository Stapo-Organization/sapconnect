#!/usr/bin/expect -f

set timeout 60
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"
expect "$*"
send "cd sapconnect_app\r"
send "mkdir -p app/Listeners\r"
send "exit\r"
expect eof

spawn scp -o StrictHostKeyChecking=no app/Listeners/UpdateLastLogin.php $user@$ip:/home/sapapimuntajat/sapconnect_app/app/Listeners/UpdateLastLogin.php
expect "*assword:*"
send "$password\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"
expect "$*"
send "cd sapconnect_app\r"
send "composer dump-autoload\r"
send "php artisan optimize:clear\r"
send "ls -la app/Listeners/UpdateLastLogin.php\r"
send "exit\r"
expect eof
