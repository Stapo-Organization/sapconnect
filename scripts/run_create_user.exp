#!/usr/bin/expect -f

set timeout 300
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn scp -o StrictHostKeyChecking=no scripts/create_user.php $user@$ip:/home/sapapimuntajat/sapconnect_app/create_user.php
expect "*assword:*"
send "$password\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
send "php create_user.php\r"
expect "$*"
send "rm create_user.php\r"
send "exit\r"
expect eof
