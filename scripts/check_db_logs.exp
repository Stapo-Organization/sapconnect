#!/usr/bin/expect -f

set timeout 30
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
send "php artisan tinker --execute=\"dump(\\App\\Models\\ApiLog::latest()->take(5)->get()->toArray());\"\r"
send "exit\r"
expect eof
