#!/usr/bin/expect -f

set timeout 300
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"

# Check Logs using php -r to avoid Tinker interactivity
send "php -r \"require 'vendor/autoload.php'; \\\$app = require_once 'bootstrap/app.php'; \\\$kernel = \\\$app->make(Illuminate\\\\Contracts\\\\Console\\\\Kernel::class); \\\$kernel->bootstrap(); print_r(App\\\\Models\\\\AutomationLog::latest()->take(3)->get()->toArray());\"\r"

send "exit\r"
expect eof
