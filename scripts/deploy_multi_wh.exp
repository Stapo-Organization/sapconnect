#!/usr/bin/expect -f

set timeout 30
set user "sapapimuntajat"
set host "62.138.14.178"
set user_pass $env(DEPLOY_PASSWORD)
set root_pass "@m123811407M@"

set app_root "/home/sapapimuntajat/sapconnect_app"
set source_dir "/home/$user"

# 1. SCP Migration
spawn scp database/migrations/2026_01_04_000000_change_warehouse_code_to_text_in_users.php $user@$host:.
expect {
    "assword:" { 
        send "$user_pass\r"
        exp_continue
    }
    "yes/no" { 
        send "yes\r"
        exp_continue
    }
    eof
}
wait

# 2. SCP User Model
spawn scp app/Models/User.php $user@$host:.
expect {
    "assword:" { 
        send "$user_pass\r"
        exp_continue
    }
    "yes/no" { 
        send "yes\r"
        exp_continue
    }
    eof
}
wait

# 3. SCP User Resource
spawn scp app/Filament/Resources/UserResource.php $user@$host:.
expect {
    "assword:" { 
        send "$user_pass\r"
        exp_continue
    }
    "yes/no" { 
        send "yes\r"
        exp_continue
    }
    eof
}
wait

# 4. SSH and Execute
spawn ssh $user@$host
expect {
    "assword:" { 
        send "$user_pass\r"
        exp_continue
    }
    "yes/no" { 
        send "yes\r"
        exp_continue
    }
}

expect -re {[\$#]}
send "su -\r"
expect "assword:"
send "$root_pass\r"
expect -re {[\$#]}

send "cd $app_root\r"
expect -re {[\$#]}

# Move Migration
send "mv -f $source_dir/2026_01_04_000000_change_warehouse_code_to_text_in_users.php database/migrations/\r"
expect -re {[\$#]}

# Move Model
send "mv -f $source_dir/User.php app/Models/\r"
expect -re {[\$#]}

# Move Resource
send "mv -f $source_dir/UserResource.php app/Filament/Resources/\r"
expect -re {[\$#]}

# Fix Permissions
send "chown -R sapapimuntajat:sapapimuntajat $app_root\r"
expect -re {[\$#]}

# Run Migration
send "php artisan migrate --force\r"
expect -re {[\$#]}

send "exit\r"
send "exit\r"
expect eof
