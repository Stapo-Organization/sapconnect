#!/usr/bin/expect -f

set timeout 60
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn scp -o StrictHostKeyChecking=no database/migrations/2025_01_01_000010_add_avatar_to_users_table.php $user@$ip:/home/sapapimuntajat/sapconnect_app/database/migrations/2025_01_01_000010_add_avatar_to_users_table.php
expect "*assword:*"
send "$password\r"
expect eof

spawn scp -o StrictHostKeyChecking=no app/Filament/Pages/Auth/EditProfile.php $user@$ip:/home/sapapimuntajat/sapconnect_app/app/Filament/Pages/Auth/EditProfile.php
expect "*assword:*"
send "$password\r"
expect eof

spawn scp -o StrictHostKeyChecking=no app/Models/User.php $user@$ip:/home/sapapimuntajat/sapconnect_app/app/Models/User.php
expect "*assword:*"
send "$password\r"
expect eof

spawn scp -o StrictHostKeyChecking=no app/Providers/Filament/AdminPanelProvider.php $user@$ip:/home/sapapimuntajat/sapconnect_app/app/Providers/Filament/AdminPanelProvider.php
expect "*assword:*"
send "$password\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "$*"
send "cd sapconnect_app\r"
send "php artisan migrate --force\r"
send "php artisan link:storage\r"
send "php artisan optimize:clear\r"
send "exit\r"
expect eof
