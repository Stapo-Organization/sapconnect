#!/usr/bin/expect -f
set timeout 60
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn scp -o StrictHostKeyChecking=no app/Services/StockTransferService.php $user@$ip:/home/sapapimuntajat/sapconnect_app/app/Services/StockTransferService.php
expect "*assword:*"
send "$password\r"
expect eof

spawn ssh -o StrictHostKeyChecking=no $user@$ip "cd sapconnect_app && php artisan sap:sync-stock-transfers"
expect "*assword:*"
send "$password\r"
expect eof
