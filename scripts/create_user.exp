#!/usr/bin/expect -f

set timeout 20
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip "cd sapconnect_app && php artisan make:filament-user --name=Admin --email=admin@muntajat.sa --password=password"
expect "*assword:*"
send "$password\r"
expect eof
