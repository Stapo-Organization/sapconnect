#!/usr/bin/expect -f

set timeout 20
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

spawn ssh -o StrictHostKeyChecking=no $user@$ip "ls -la sapconnect_app/vendor && ls -la public_html && php sapconnect_app/artisan --version"
expect "*assword:*"
send "$password\r"
expect eof
