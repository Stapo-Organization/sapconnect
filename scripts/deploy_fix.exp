#!/usr/bin/expect -f

set timeout 300
set ip "62.138.14.178"
set user "sapapimuntajat"
set password $env(DEPLOY_PASSWORD)

# 1. Upload Service
spawn scp -o StrictHostKeyChecking=no app/Services/StockTransferService.php $user@$ip:/home/sapapimuntajat/sapconnect_app/app/Services/
expect "*assword:*"
send "$password\r"
expect eof

# 2. Clear Cache (Just in case)
spawn ssh -o StrictHostKeyChecking=no $user@$ip
expect "*assword:*"
send "$password\r"

expect "*$*"
send "cd sapconnect_app\r"
send "php artisan optimize:clear\r"

expect "*$*"
send "exit\r"
expect eof
