#!/usr/bin/expect -f

set timeout 60
set user "sapapimuntajat"
set host "62.138.14.178"
set user_pass $env(DEPLOY_PASSWORD)
set root_pass "@m123811407M@"

set app_root "/home/sapapimuntajat/sapconnect_app"

# 1. SCP Migration
spawn scp database/migrations/2026_01_06_000002_add_unique_hash_alrajhi.php $user@$host:.
expect {
    "assword:" { send "$user_pass\r"; exp_continue }
    "yes/no" { send "yes\r"; exp_continue }
    eof
}
wait

# 2. SCP Model
spawn scp app/Models/AlrajhiTransaction.php $user@$host:.
expect {
    "assword:" { send "$user_pass\r"; exp_continue }
    eof
}
wait

# 3. SCP Resource
spawn scp app/Filament/Resources/AlrajhiTransactionResource.php $user@$host:.
expect {
    "assword:" { send "$user_pass\r"; exp_continue }
    eof
}
wait

# 4. SSH and Deploy
spawn ssh $user@$host
expect {
    "assword:" { send "$user_pass\r" }
    "yes/no" { send "yes\r" }
}

expect -re {[\$#]}
send "su -\r"
expect "assword:"
send "$root_pass\r"
expect -re {[\$#]}

send "cd $app_root\r"
expect -re {[\$#]}

# Move files
send "mv -f /home/$user/2026_01_06_000002_add_unique_hash_alrajhi.php database/migrations/\r"
expect -re {[\$#]}

send "mv -f /home/$user/AlrajhiTransaction.php app/Models/\r"
expect -re {[\$#]}

send "mv -f /home/$user/AlrajhiTransactionResource.php app/Filament/Resources/\r"
expect -re {[\$#]}

# Run Migrations
send "php artisan migrate --force\r"
expect -re {[\$#]}

# Fix Permissions
send "chown -R sapapimuntajat:sapapimuntajat $app_root\r"
expect -re {[\$#]}

send "exit\r"
send "exit\r"
expect eof
