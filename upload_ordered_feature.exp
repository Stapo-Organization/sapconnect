#!/usr/bin/expect -f
match_max 100000
set timeout -1
set password "h23N1KXMIL#\$94"
set user_host "sapapimuntajat@62.138.14.178"
set app_dir "sapconnect_app"
set local_dir "."

spawn scp -o StrictHostKeyChecking=no $local_dir/database/migrations/2026_04_21_121500_add_ordered_to_warehouse_item_stocks.php $user_host:$app_dir/database/migrations/2026_04_21_121500_add_ordered_to_warehouse_item_stocks.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "1 uploaded." }
}
spawn scp -o StrictHostKeyChecking=no $local_dir/app/Models/WarehouseItemStock.php $user_host:$app_dir/app/Models/WarehouseItemStock.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "2 uploaded." }
}
spawn scp -o StrictHostKeyChecking=no $local_dir/app/Jobs/FetchSapItemStockJob.php $user_host:$app_dir/app/Jobs/FetchSapItemStockJob.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "3 uploaded." }
}
spawn scp -o StrictHostKeyChecking=no $local_dir/app/Jobs/CalculateStockOpportunitiesJob.php $user_host:$app_dir/app/Jobs/CalculateStockOpportunitiesJob.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "4 uploaded." }
}

spawn ssh -o StrictHostKeyChecking=no $user_host "cd sapconnect_app && php artisan migrate --force && php artisan queue:restart"
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "Commands finished." }
}
