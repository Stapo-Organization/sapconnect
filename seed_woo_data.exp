#!/usr/bin/expect -f
match_max 100000
set timeout 60
set password "h23N1KXMIL#\$94"
set user_host "sapapimuntajat@62.138.14.178"

# Step 1: Flag production products for WooCommerce sync (limit first 100)
spawn ssh -o StrictHostKeyChecking=no $user_host "cd sapconnect_app && php artisan tinker --execute=\"\
\$count = \\App\\Models\\Product::where('source','production')->update(['woo_sync' => true]);\
echo \\\"Flagged \\\$count products for WooCommerce sync\\\\n\\\";\
\""
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof {}
}

# Step 2: Seed Zooboxi warehouses
