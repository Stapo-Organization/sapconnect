#!/usr/bin/expect -f
match_max 100000
set timeout -1
set password "h23N1KXMIL#\$94"
set user_host "sapapimuntajat@62.138.14.178"

# Upload Product.php
spawn scp -o StrictHostKeyChecking=no app/Models/Product.php $user_host:sapconnect_app/app/Models/Product.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "Product.php uploaded" }
}

# Upload SyncProducts.php
spawn scp -o StrictHostKeyChecking=no app/Console/Commands/SyncProducts.php $user_host:sapconnect_app/app/Console/Commands/SyncProducts.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "SyncProducts.php uploaded" }
}

# Upload migration
spawn scp -o StrictHostKeyChecking=no database/migrations/2026_04_20_130300_add_custom_fields_to_products_table.php $user_host:sapconnect_app/database/migrations/2026_04_20_130300_add_custom_fields_to_products_table.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "Migration uploaded" }
}

# Run SSH commands
spawn ssh -o StrictHostKeyChecking=no $user_host "cd sapconnect_app && php artisan migrate && php artisan sap:sync-products --code=sync_products_PPTC_V5_PROD"
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts $expect_out(buffer) }
}
