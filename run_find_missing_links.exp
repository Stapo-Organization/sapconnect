#!/usr/bin/expect -f
match_max 100000
set timeout -1
set password "h23N1KXMIL#\$94"
set user_host "sapapimuntajat@62.138.14.178"

spawn scp -o PubkeyAuthentication=no -o StrictHostKeyChecking=no find_missing_links.php $user_host:sapconnect_app/find_missing_links.php
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts "Uploaded find script" }
}

spawn ssh -o PubkeyAuthentication=no -o StrictHostKeyChecking=no $user_host "cd sapconnect_app && php find_missing_links.php"
expect {
    "assword:" { send "$password\r"; exp_continue }
    eof { puts $expect_out(buffer) }
}
