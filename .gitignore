# ── Secrets & environment ───────────────────────────────
.env
.env.*
!.env.example
*.exp

# ── PHP / Node dependencies ─────────────────────────────
/vendor/
/node_modules/

# ── Laravel runtime & caches ────────────────────────────
/storage/framework/
/storage/logs/
/storage/*.key
/bootstrap/cache/*.php

# ── Local databases & dumps ─────────────────────────────
*.sqlite
*.sqlite-journal
*.sql

# ── Ad-hoc local scripts (root only) ────────────────────
/check_barcodes.php
/fix_*.php

# ── OS / editor junk ────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# Google service-account keys (secrets — never commit)
storage/app/google/
*.sa.json

# Firebase admin credentials (FCM push — secrets, never commit)
/storage/app/firebase/
firebase-credentials*.json
*-firebase-adminsdk-*.json
*.p8
GoogleService-Info.plist
google-services.json
